<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark only; an ink window background so nothing flashes white before Compose draws. -->
    <style name="Theme.JoinrFinance" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:colorBackground">@color/ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
